# ---------------------------------------------------------------
# Backend: "ollama" (fully local) or "gemini" (cloud API)
# ---------------------------------------------------------------
BACKEND=ollama

# --- Ollama settings (used when BACKEND=ollama) ---
# Use host.docker.internal when running the app inside Docker and Ollama is on the host:
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Gemini settings (used when BACKEND=gemini) ---
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-1.5-pro
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ---------------------------------------------------------------
# Shared settings
# ---------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Override HTR prompt if needed (uncomment and edit)
# HTR_PROMPT=You are an expert paleographer...
